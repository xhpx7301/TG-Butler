#!/bin/sh
set -eu

STATE_DIR=/var/lib/tg-butler
MARKER="$STATE_DIR/data/monitor-enabled"
SUPERVISORCTL=/opt/venv/bin/supervisorctl
SUPERVISOR_CONFIG=/etc/supervisor/supervisord.conf
PROGRAM=tg-butler-monitor

supervisorctl() {
    "$SUPERVISORCTL" -c "$SUPERVISOR_CONFIG" "$@"
}

status() {
    if supervisorctl status "$PROGRAM" 2>/dev/null | grep -q ' RUNNING '; then
        printf 'active\n'
    else
        printf 'inactive\n'
    fi
}

case "${1:-}" in
    status)
        status
        ;;
    start)
        touch "$MARKER"
        if [ "$(status)" != active ]; then
            supervisorctl start "$PROGRAM"
        fi
        ;;
    stop)
        rm -f "$MARKER"
        supervisorctl stop "$PROGRAM" >/dev/null 2>&1 || true
        printf '任务服务已停止。\n'
        ;;
    restart)
        touch "$MARKER"
        if [ "$(status)" = active ]; then
            supervisorctl restart "$PROGRAM"
        else
            supervisorctl start "$PROGRAM"
        fi
        ;;
    logs)
        supervisorctl tail "$PROGRAM" stdout
        ;;
    update)
        printf 'Docker 部署请在宿主机执行 docker compose up -d --build 更新。\n' >&2
        exit 2
        ;;
    *)
        exit 2
        ;;
esac

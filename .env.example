# Apply at https://my.telegram.org -> API development tools. Enter your own values.
TG_API_ID=
TG_API_HASH=
# Legacy single-bot configuration (optional fallback).
TG_BOT_TOKEN=
TG_NOTIFY_CHAT_ID=
# Recommended split configuration: monitor alerts and report alerts use separate bots.
TG_MONITOR_BOT_TOKEN=
TG_MONITOR_NOTIFY_CHAT_ID=
TG_REPORT_BOT_TOKEN=
TG_REPORT_NOTIFY_CHAT_ID=
# Optional: API key for a chat-completions-compatible summary provider.
SUMMARY_API_KEY=

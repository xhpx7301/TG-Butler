[Unit]
Description=TG-Butler Chinese web administration
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tgbutler
Group=tgbutler
WorkingDirectory=/opt/tg-butler
ExecStart=/opt/tg-butler/.venv/bin/tg-butler-web --config /opt/tg-butler/config.yaml
Restart=on-failure
RestartSec=10
UMask=0077
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/tg-butler

[Install]
WantedBy=multi-user.target
